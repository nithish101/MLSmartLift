# Copy to .env and adjust. docker compose reads .env automatically.
POSTGRES_USER=smartlift
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartlift

# Comma-separated origins allowed to call the API ("*" for any).
CORS_ORIGINS=*

# Registry stage the API serves, and how often (seconds) it checks for a newly promoted version.
MODEL_STAGE=Production
MODEL_REFRESH_SECONDS=30

# Redis cache TTLs (seconds) for predictions and history-derived features.
PREDICTION_CACHE_TTL_SECONDS=3600
FEATURE_CACHE_TTL_SECONDS=300

# For running the API or training outside Docker (from backend/):
# DATABASE_URL=postgresql+psycopg://smartlift:change-me@localhost:5432/smartlift
# MLFLOW_TRACKING_URI=http://localhost:5050
# REDIS_URL=redis://localhost:6379/0
